<?xml version='1.0' encoding='UTF-8'?>
<!-- /tm/v1/history: the GData video feed (gdata/videos.xml) plus tm:position / tm:watched per entry. -->
<feed xmlns='http://www.w3.org/2005/Atom' xmlns:gd='http://schemas.google.com/g/2005' xmlns:openSearch='http://a9.com/-/spec/opensearch/1.1/' xmlns:yt='{{ base }}/schemas/2007' xmlns:media='http://search.yahoo.com/mrss/' xmlns:tm='urn:tubemini:1' gd:etag='W/&quot;DkcBQ3g-fip7I2A9XRRXEUw.&quot;'>
	<id>tag:youtube.com,2008:tm:history</id>
	<updated>{{ updated }}</updated>
	<category scheme='http://schemas.google.com/g/2005#kind' term='{{ base }}/schemas/2007#video'/>
	<title>Lịch sử xem</title>
	<logo>http://www.gstatic.com/youtube/img/logo.png</logo>
	<link rel='http://schemas.google.com/g/2005#feed' type='application/atom+xml' href='{{ self_url }}'/>
	<link rel='self' type='application/atom+xml' href='{{ self_url }}'/>
{%- if let Some(next) = next %}
	<link rel='next' type='application/atom+xml' href='{{ next }}'/>
{%- endif %}
	<author>
		<name>YouTube</name>
		<uri>http://www.youtube.com/</uri>
	</author>
	<generator version='2.1' uri='{{ base }}/'>YouTube data API</generator>
	<openSearch:totalResults>{{ total }}</openSearch:totalResults>
	<openSearch:startIndex>{{ start_index }}</openSearch:startIndex>
	<openSearch:itemsPerPage>{{ items.len() }}</openSearch:itemsPerPage>
{%- for (v, position, watched) in items %}
	<entry gd:etag='W/&quot;YDwqeyM.&quot;'>
{% include "gdata/_entry_body.xml" %}
		<tm:position seconds='{{ position }}'/>
		<tm:watched>{{ watched }}</tm:watched>
	</entry>
{%- endfor %}
</feed>
