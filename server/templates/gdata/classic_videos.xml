<?xml version='1.0' encoding='UTF-8'?>
<!-- GData video feed for the "classic" YouTube app (Apple's built-in app, User-Agent "YouTube v1.0.0").
     Format follows the TubeRepair server templates classic/featured and classic/search
     (https://github.com/kevinf100/tuberepair.uptimetrackers.com, GPL-3.0). Like TubeRepair, no
     next-page link is emitted for this app. -->
<feed xmlns='http://www.w3.org/2005/Atom' xmlns:gd='http://schemas.google.com/g/2005' xmlns:openSearch='http://a9.com/-/spec/opensearch/1.1/' xmlns:yt='http://gdata.youtube.com/schemas/2007' xmlns:media='http://search.yahoo.com/mrss/' gd:etag=''>
	<id>http://gdata.youtube.com/feeds/api/videos/</id>
	<category scheme='http://schemas.google.com/g/2005#kind' term='http://gdata.youtube.com/schemas/2007#video'/>
	<title>{{ title }}</title>
	<logo>http://www.gstatic.com/youtube/img/logo.png</logo>
	<link rel='http://schemas.google.com/g/2005#feed' type='application/atom+xml' href='{{ self_url }}'/>
	<link rel='self' type='application/atom+xml' href='{{ self_url }}'/>
	<author>
		<name>YouTube</name>
		<uri>http://www.youtube.com/</uri>
	</author>
	<generator version='2.0' uri='{{ base }}/'>YouTube data API</generator>
	<openSearch:totalResults>{{ total }}</openSearch:totalResults>
	<openSearch:itemsPerPage>{{ videos.len() }}</openSearch:itemsPerPage>
	<openSearch:startIndex>{{ start_index }}</openSearch:startIndex>
{%- for v in videos %}
	<entry gd:etag='X7TQO_tCDyvjdmzy26zWmC5Mbwc'>
		<id>tag:youtube.com,2008:video:{{ v.id }}</id>
		<published>{{ v.published_iso() }}</published>
		<updated>{{ v.published_iso() }}</updated>
		<category scheme='http://schemas.google.com/g/2005#kind' term='http://gdata.youtube.com/schemas/2007#video'/>
		<category scheme='http://gdata.youtube.com/schemas/2007/categories.cat' term='Entertainment' label='Entertainment'/>
		<title>{{ v.title }}</title>
		<content type='video/mp4' src='{{ base }}/video/sd/{{ v.id }}'/>
		<link rel='alternate' type='text/html' href='https://www.youtube.com/watch?v={{ v.id }}&amp;feature=youtube_gdata'/>
		<link rel='http://gdata.youtube.com/schemas/2007#video.related' type='application/atom+xml' href='{{ base }}/feeds/api/videos/{{ v.id }}/related'/>
		<link rel='http://gdata.youtube.com/schemas/2007#video.captionTracks' type='application/atom+xml' href='{{ base }}/feeds/api/videos/{{ v.id }}/captions' yt:hasEntries='false'/>
		<link rel='http://gdata.youtube.com/schemas/2007#mobile' type='text/html' href='http://m.youtube.com/details?v={{ v.id }}'/>
		<link rel='http://gdata.youtube.com/schemas/2007#uploader' type='application/atom+xml' href='{{ base }}/feeds/api/users/{{ v.author_id }}'/>
		<link rel='self' type='application/atom+xml' href='{{ base }}/feeds/api/videos/{{ v.id }}'/>
		<author>
			<name>{{ v.author }}</name>
			<uri>{{ base }}/feeds/api/users/{{ v.author_id }}</uri>
			<yt:userId>{{ v.author_id }}</yt:userId>
		</author>
		<yt:accessControl action='comment' permission='allowed'/>
		<yt:accessControl action='commentVote' permission='allowed'/>
		<yt:accessControl action='videoRespond' permission='denied'/>
		<yt:accessControl action='rate' permission='allowed'/>
		<yt:accessControl action='embed' permission='allowed'/>
		<yt:accessControl action='list' permission='allowed'/>
		<yt:accessControl action='monetize' permission='denied'/>
		<yt:accessControl action='autoPlay' permission='allowed'/>
		<yt:accessControl action='syndicate' permission='allowed'/>
		<gd:comments><gd:feedLink href='{{ base }}/api/videos/{{ v.id }}/comments'/></gd:comments>
		<yt:statistics favoriteCount='0' viewCount='{{ v.views }}'/>
		<gd:rating average='5' max='5' min='1' numRaters='1' rel='http://schemas.google.com/g/2005#overall'/>
		<yt:rating numDislikes='0' numLikes='0'/>
		<media:group>
			<media:category label='Entertainment' scheme='http://gdata.youtube.com/schemas/2007/categories.cat'>Entertainment</media:category>
			<media:content url='{{ base }}/getvideo/{{ v.id }}' type='video/mp4' medium='video' isDefault='true' expression='full' duration='{{ v.duration }}' yt:format='3'/>
			<media:content url='{{ base }}/getvideo/{{ v.id }}' type='video/3gpp' medium='video' expression='full' duration='{{ v.duration }}' yt:format='2'/>
			<media:content url='{{ base }}/getvideo/{{ v.id }}' type='video/mp4' medium='video' expression='full' duration='{{ v.duration }}' yt:format='8'/>
			<media:content url='{{ base }}/getvideo/{{ v.id }}' type='video/3gpp' medium='video' expression='full' duration='{{ v.duration }}' yt:format='9'/>
			<media:credit role='uploader' scheme='urn:youtube' yt:display='{{ v.author }}'>{{ v.author }}</media:credit>
			<media:description type='plain'>{{ v.description }}</media:description>
			<media:keywords></media:keywords>
			<media:license type='text/html' href='http://www.youtube.com/t/terms'>youtube</media:license>
			<media:player url='https://www.youtube.com/watch?v={{ v.id }}&amp;feature=youtube_gdata_player'/>
			<media:thumbnail url='https://i.ytimg.com/vi/{{ v.id }}/default.jpg' height='90' width='120' yt:name='default'/>
			<media:thumbnail url='https://i.ytimg.com/vi/{{ v.id }}/mqdefault.jpg' height='180' width='320' yt:name='mqdefault'/>
			<media:thumbnail url='https://i.ytimg.com/vi/{{ v.id }}/hqdefault.jpg' height='360' width='480' yt:name='hqdefault'/>
			<media:title type='plain'>{{ v.title }}</media:title>
			<yt:aspectRatio>widescreen</yt:aspectRatio>
			<yt:duration seconds='{{ v.duration }}'/>
			<yt:uploaded>{{ v.published_iso() }}</yt:uploaded>
			<yt:uploaderId>{{ v.author_id }}</yt:uploaderId>
			<yt:videoid>{{ v.id }}</yt:videoid>
		</media:group>
	</entry>
{%- endfor %}
</feed>
