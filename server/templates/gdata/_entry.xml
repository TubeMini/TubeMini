		<link rel='{{ base }}/schemas/2007#video.related' type='application/atom+xml' href='{{ base }}/feeds/api/videos/{{ v.id }}/related'/>
		<link rel='http://gdata.youtube.com/schemas/2007#mobile' type='text/html' href='https://m.youtube.com/details?v={{ v.id }}'/>
		<link rel='http://gdata.youtube.com/schemas/2007#uploader' type='application/atom+xml' href='{{ base }}/feeds/api/users/{{ v.author_id }}?v=2'/>
		<link rel='related' type='application/atom+xml' href='{{ base }}/feeds/api/videos/{{ v.id }}?v=2'/>
		<link rel='self' type='application/atom+xml' href='{{ base }}/feeds/api/videos/{{ v.id }}?v=2'/>
		<author>
			<name>{{ v.author }}</name>
			<uri>{{ base }}/feeds/api/users/{{ v.author_id }}</uri>
			<yt:userId>{{ v.author_id }}</yt:userId>
		</author>
		<yt:accessControl action='comment' permission='allowed'/>
