			<media:content url='{{ base }}/getvideo/{{ v.id }}' type='video/3gpp' medium='video' expression='full' duration='{{ v.duration }}' yt:format='2'/>
			<media:content url='{{ base }}/getvideo/{{ v.id }}' type='video/mp4' medium='video' expression='full' duration='{{ v.duration }}' yt:format='8'/>
			<media:content url='{{ base }}/getvideo/{{ v.id }}' type='video/3gpp' medium='video' expression='full' duration='{{ v.duration }}' yt:format='9'/>
			<media:title type='plain'>{{ v.title }}</media:title>
			<yt:duration seconds='{{ v.duration }}'/>
			<yt:uploaded>{{ v.published_iso() }}</yt:uploaded>
			<yt:uploaderId>{{ v.author_id }}</yt:uploaderId>
			<yt:videoid>{{ v.id }}</yt:videoid>
		</media:group>
		<gd:rating average='0' max='0' min='0' numRaters='0' rel='http://schemas.google.com/g/2005#overall'/>
		<yt:recorded>1970-08-22</yt:recorded>
		<yt:statistics favoriteCount='0' viewCount='{{ v.views }}'/>
		<yt:rating numDislikes='0' numLikes='0'/>
	</entry>
