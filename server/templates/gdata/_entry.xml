	<entry gd:etag='W/&quot;YDwqeyM.&quot;'>
		<id>tag:youtube.com,2008:video:{{ v.id }}</id>
		<published>{{ v.published_iso() }}</published>
		<updated>{{ v.published_iso() }}</updated>
		<category scheme='http://schemas.google.com/g/2005#kind' term='{{ base }}/schemas/2007#video'/>
		<category scheme='{{ base }}/schemas/2007/categories.cat' term='Howto' label='Howto &amp; Style'/>
		<title>{{ v.title }}</title>
		<content type='application/x-shockwave-flash' src='https://www.youtube.com/v/{{ v.id }}?version=3&amp;f=playlists&amp;app=youtube_gdata'/>
		<link rel='alternate' type='text/html' href='https://www.youtube.com/watch?v={{ v.id }}&amp;feature=youtube_gdata'/>
