			<gd:feedLink rel='http://gdata.youtube.com/schemas/2007#comments' href='{{ base }}/api/videos/{{ v.id }}/comments?v=2' countHint='5'/>
		</gd:comments>
		<media:group>
			<media:category label='Howto &amp; Style' scheme='http://gdata.youtube.com/schemas/2007/categories.cat'>Howto</media:category>
			<media:content url='https://www.youtube.com/v/{{ v.id }}?version=3&amp;f=playlists&amp;app=youtube_gdata' type='application/x-shockwave-flash' medium='video' isDefault='true' expression='full' duration='{{ v.duration }}' yt:format='5'/>
			<media:content url='{{ base }}/getvideo/{{ v.id }}' type='video/3gpp' medium='video' expression='full' duration='{{ v.duration }}' yt:format='1'/>
			<media:content url='{{ base }}/getvideo/{{ v.id }}' type='video/3gpp' medium='video' expression='full' duration='{{ v.duration }}' yt:format='6'/>
			<media:credit role='uploader' scheme='urn:youtube' yt:display='{{ v.author }}' yt:type='partner'>{{ v.author_id }}</media:credit>
			<media:description type='plain'>{{ v.description }}</media:description>
			<media:keywords/>
			<media:license type='text/html' href='https://www.youtube.com/t/terms'>youtube</media:license>
			<media:player url='https://www.youtube.com/watch?v={{ v.id }}&amp;feature=youtube_gdata_player'/>
			<media:thumbnail url='https://i.ytimg.com/vi/{{ v.id }}/default.jpg' height='90' width='120' time='00:00:00.000' yt:name='default'/>
			<media:thumbnail url='https://i.ytimg.com/vi/{{ v.id }}/mqdefault.jpg' height='180' width='320' yt:name='mqdefault'/>
			<media:thumbnail url='https://i.ytimg.com/vi/{{ v.id }}/hqdefault.jpg' height='360' width='480' yt:name='hqdefault'/>
			<media:thumbnail url='https://i.ytimg.com/vi/{{ v.id }}/default.jpg' height='90' width='120' time='00:00:00.000' yt:name='start'/>
			<media:thumbnail url='https://i.ytimg.com/vi/{{ v.id }}/default.jpg' height='90' width='120' time='00:00:00.000' yt:name='middle'/>
			<media:thumbnail url='https://i.ytimg.com/vi/{{ v.id }}/default.jpg' height='90' width='120' time='00:00:00.000' yt:name='end'/>
