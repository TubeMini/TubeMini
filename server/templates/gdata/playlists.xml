<?xml version='1.0' encoding='UTF-8'?>
<!-- GData playlist list (channel playlists, playlist search). Format follows the TubeRepair server
     templates (https://github.com/kevinf100/tuberepair.uptimetrackers.com, GPL-3.0); links point to this
     server instead of gdata.youtube.com. -->
<feed xmlns='http://www.w3.org/2005/Atom' xmlns:media='http://search.yahoo.com/mrss/' xmlns:openSearch='http://a9.com/-/spec/opensearchrss/1.0/' xmlns:gd='http://schemas.google.com/g/2005' xmlns:yt='http://gdata.youtube.com/schemas/2007'>
	<id>{{ self_url }}</id>
	<updated>{{ updated }}</updated>
	<category scheme='http://schemas.google.com/g/2005#kind' term='http://gdata.youtube.com/schemas/2007#playlistLink'/>
	<title type='text'>{{ title }}</title>
	<logo>http://www.youtube.com/img/pic_youtubelogo_123x63.gif</logo>
	<link rel='http://schemas.google.com/g/2005#feed' type='application/atom+xml' href='{{ self_url }}'/>
	<link rel='self' type='application/atom+xml' href='{{ self_url }}'/>
{%- if let Some(next) = next %}
	<link rel='next' type='application/atom+xml' href='{{ next }}'/>
{%- endif %}
	<author>
		<name>YouTube</name>
		<uri>http://www.youtube.com/</uri>
	</author>
	<generator version='2.1' uri='{{ base }}/'>YouTube data API</generator>
	<openSearch:totalResults>{{ total }}</openSearch:totalResults>
	<openSearch:startIndex>{{ start_index }}</openSearch:startIndex>
	<openSearch:itemsPerPage>{{ items.len() }}</openSearch:itemsPerPage>
{%- for p in items %}
	<entry>
		<id>{{ base }}/feeds/api/users/{{ p.author_id }}/playlists/{{ p.id }}</id>
		<published>{{ updated }}</published>
		<updated>{{ updated }}</updated>
		<category scheme='http://schemas.google.com/g/2005#kind' term='http://gdata.youtube.com/schemas/2007#playlistLink'/>
		<title type='text'>{{ p.title }}</title>
		<content type='text'/>
		<link rel='related' type='application/atom+xml' href='{{ base }}/feeds/api/users/{{ p.author_id }}'/>
		<link rel='alternate' type='text/html' href='https://www.youtube.com/playlist?list={{ p.id }}'/>
		<link rel='self' type='application/atom+xml' href='{{ base }}/feeds/api/users/{{ p.author_id }}/playlists/{{ p.id }}'/>
		<author>
			<name>{{ p.author }}</name>
			<uri>{{ base }}/feeds/api/users/{{ p.author_id }}</uri>
		</author>
		<yt:description></yt:description>
		<summary></summary>
		<gd:feedLink rel='http://gdata.youtube.com/schemas/2007#playlist' href='{{ base }}/feeds/api/playlists/{{ p.id }}' countHint='{{ p.count }}'/>
		<yt:countHint>{{ p.count }}</yt:countHint>
		<media:group>
			<media:thumbnail url='https://i.ytimg.com/vi/{{ p.thumb_video }}/default.jpg' height='90' width='120' yt:name='default'/>
			<media:thumbnail url='https://i.ytimg.com/vi/{{ p.thumb_video }}/mqdefault.jpg' height='180' width='320' yt:name='mqdefault'/>
			<media:thumbnail url='https://i.ytimg.com/vi/{{ p.thumb_video }}/hqdefault.jpg' height='360' width='480' yt:name='hqdefault'/>
			<yt:duration seconds='0'/>
		</media:group>
		<yt:playlistId>{{ p.id }}</yt:playlistId>
	</entry>
{%- endfor %}
</feed>
